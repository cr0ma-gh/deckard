#!/usr/bin/env bash
# Deckard session manager, started by greetd at boot.
#
# Runs in a loop: reads ~/.local/state/deckard/next-session to decide which
# session to start (deckard or steam), launches it and waits. When the session
# exits, the loop reads the file again. If the file does not exist after a
# session exits (nobody wrote it), the loop ends and greetd falls back to the
# text login (agreety) for debugging.
#
# Overrides (in ~/.config/deckard/session.env):
#   DECKARD_COMPOSITOR=gamescope|cage   force a compositor
#   DECKARD_GAMESCOPE_ARGS="..."        extra gamescope arguments
set -euo pipefail

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/deckard"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/deckard"
mkdir -p "$state_dir"

if [[ -f "$config_dir/session.env" ]]; then
  # shellcheck source=/dev/null
  source "$config_dir/session.env"
fi

log="$state_dir/session.log"
exec >> "$log" 2>&1
echo "=== deckard-session $(date --iso-8601=seconds)"
# Tells Deckard it runs as the device session (enables power off/reboot).
export DECKARD_SESSION=1

next_session_file="$state_dir/next-session"

# Detect the compositor once at startup.
compositor="${DECKARD_COMPOSITOR:-}"
if [[ -z "$compositor" ]]; then
  if systemd-detect-virt --quiet; then
    compositor=cage
  else
    compositor=gamescope
  fi
fi
echo "compositor: $compositor"

# ---- session loop ----
# On first boot next-session usually does not exist → default to deckard.
# After that, the frontend or the switch script writes it before exiting.
first_run=true

while true; do
  if [[ -f "$next_session_file" ]]; then
    session=$(<"$next_session_file")
    rm -f "$next_session_file"
  elif "$first_run"; then
    session=deckard
  else
    # No file after a session exited: stop the loop (crash/debug scenario).
    echo "no next-session file, exiting session manager"
    break
  fi
  first_run=false

  echo "--- starting session: $session ($(date --iso-8601=seconds))"

  case "$session" in
    deckard)
      case "$compositor" in
        gamescope)
          # shellcheck disable=SC2086 # word splitting intended
          gamescope -f ${DECKARD_GAMESCOPE_ARGS:-} -- deckard --fullscreen || true
          ;;
        cage)
          cage -s -- deckard --fullscreen || true
          ;;
        *)
          echo "unknown compositor: $compositor" >&2
          break
          ;;
      esac
      ;;
    steam)
      case "$compositor" in
        gamescope)
          # -e: Steam integration (focus, overlay, Steam's keyboard). Steam
          # runs in a restart loop inside, so gamescope survives its updates.
          # shellcheck disable=SC2086 # word splitting intended
          gamescope -e -f ${DECKARD_GAMESCOPE_ARGS:-} -- deckard-steam-session || true
          # Steam gone without a switch request (crash, gamescope exit): go
          # back to Deckard instead of the text login.
          if [[ ! -f $next_session_file ]]; then
            echo deckard >"$next_session_file"
          fi
          ;;
        cage)
          echo "Steam requires gamescope (Vulkan GPU); cannot run under cage" >&2
          # Fall back to deckard on next iteration.
          echo "deckard" > "$next_session_file"
          ;;
        *)
          echo "unknown compositor: $compositor" >&2
          break
          ;;
      esac
      ;;
    *)
      echo "unknown session: $session" >&2
      break
      ;;
  esac

  echo "--- session '$session' exited ($(date --iso-8601=seconds))"
done
